<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.0.7</version>
    <relativePath/> <!-- lookup parent from repository -->
  </parent>
  <groupId>dev.ted</groupId>
  <artifactId>jittertravel</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <name>jittertravel</name>
  <description>jittertravel</description>
  <url/>
  <licenses>
    <license/>
  </licenses>
  <developers>
    <developer/>
  </developers>
  <scm>
    <connection/>
    <developerConnection/>
    <tag/>
    <url/>
  </scm>
  <properties>
    <java.version>26</java.version>
    <spring-modulith.version>2.0.6</spring-modulith.version>
    <playwright.version>1.49.0</playwright.version>
  </properties>
  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-thymeleaf</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.modulith</groupId>
      <artifactId>spring-modulith-starter-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-thymeleaf-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.modulith</groupId>
      <artifactId>spring-modulith-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-docker-compose</artifactId>
      <scope>runtime</scope>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>digital.pragmatech.testing</groupId>
      <artifactId>spring-test-profiler</artifactId>
      <version>0.1.0</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <version>1.5.1</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-devtools</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>com.j2html</groupId>
      <artifactId>j2html</artifactId>
      <version>1.6.0</version>
    </dependency>
    <!-- JS-behavior tests only (see docs/JS-Behavior-Tests.md). Tagged "js" and
         excluded from the default build; run with `mvn test -Pjs-tests`. -->
    <dependency>
      <groupId>com.microsoft.playwright</groupId>
      <artifactId>playwright</artifactId>
      <version>${playwright.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- SPIKE: Strictland event-serialization contract testing.
         See docs/Event_Serialization_Contract_Tests.md. Evaluate, then keep or remove. -->
    <dependency>
      <groupId>io.event-driven</groupId>
      <artifactId>strictland</artifactId>
      <version>0.3.0</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.modulith</groupId>
        <artifactId>spring-modulith-bom</artifactId>
        <version>${spring-modulith.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <plugins>
      <plugin>
        <groupId>org.pitest</groupId>
        <artifactId>pitest-maven</artifactId>
        <version>1.30.0</version>
        <!-- Mutation testing over the plain unit tests only. Not bound to a phase, so the
             default build never runs it; run it by hand:
               ./mvnw test-compile org.pitest:pitest-maven:mutationCoverage
             Report lands in target/pit-reports/index.html.

             excludedGroups is the whole point of this block. A Spring test re-run once per
             mutant is slow for no gain (a full context boots a Testcontainers database), so
             every one carries @Tag("spring") and SpringTestsAreTaggedTest fails on one that
             does not. js and replay-preflight are left out for the reasons surefire leaves
             them out; performance is a timing probe, not an assertion about behaviour. -->
        <configuration>
          <targetClasses>
            <param>dev.ted.jittertravel.*</param>
          </targetClasses>
          <targetTests>
            <param>dev.ted.jittertravel.*</param>
          </targetTests>
          <excludedGroups>
            <param>spring</param>
            <param>js</param>
            <param>replay-preflight</param>
            <param>performance</param>
          </excludedGroups>
          <!-- Same JVM zone as surefire's argLine, or zone-dependent tests fail under PIT
               for reasons that have nothing to do with the mutant. -->
          <jvmArgs>
            <value>-Duser.timezone=UTC</value>
          </jvmArgs>
          <threads>4</threads>
          <timestampedReports>false</timestampedReports>
        </configuration>
        <dependencies>
          <dependency>
            <groupId>org.pitest</groupId>
            <artifactId>pitest-junit5-plugin</artifactId>
            <version>1.2.3</version>
          </dependency>
        </dependencies>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>build-info</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <!-- The default build skips JS-behavior tests (browser binaries) and the boot-replay
           preflight (needs a production dump to hand). Run them explicitly with `mvn test -Pjs-tests`
           / `mvn test -Preplay-preflight -Dpreflight.dump=…`. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <excludedGroups>js,replay-preflight</excludedGroups>
          <!-- Pin the test JVM to UTC so timezone-dependent tests behave the same
               on every machine and on CI, regardless of the host's default zone.
               The logging config exists for one line of output and src/test/resources/
               logging.properties says which — the seed below has a twin that JUnit prints
               at CONFIG level, which nothing else in this build would show. -->
          <argLine>-Duser.timezone=UTC -Djava.util.logging.config.file=${project.basedir}/src/test/resources/logging.properties</argLine>
          <!-- Order must not matter (CLAUDE.md, "Every test is isolated"), so shuffle it
               rather than trusting the default filesystem order to keep proving nothing.
               An order-dependence then fails on the run that introduces it, instead of
               years later when an unrelated rename moves two classes past each other.

               This setting shuffles test CLASSES only. The METHODS inside a class are
               shuffled by junit-platform.properties, which is the commoner kind of
               order-dependence and the half this alone would leave unenforced.

               A shuffled failure is still REPRODUCIBLE, and that is what makes this
               usable rather than a flakiness generator: every run logs
                 "Tests will run in random order. To reproduce ordering use flag
                  -Dsurefire.runOrder.random.seed=<n>"
               Re-run with that seed to get the same order back. Without it the failure
               reads as flake and gets re-run until green, which is what shuffling is
               here to prevent. The method order has its own seed and its own line —
               both halves have to be passed back to reproduce a run exactly. -->
          <runOrder>random</runOrder>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <!-- Bootstrap the tracked git hooks: point core.hooksPath at .githooks so the
           pre-push MUST-PASS gate runs after a fresh clone without the manual
           `git config core.hooksPath .githooks` (see README).

           Two layers keep a non-git build (Railway's /app source copy, a release
           tarball) green: (1) the profile activates ONLY when a .git directory is
           present, so it normally doesn't run there at all; (2) the command itself
           is `sh -c "… || true"`, so even if a .git dir does reach a git-less build
           image the step is a harmless no-op. Both matter because the exec goal has
           no failOnError, so invoking a missing `git` binary directly would throw
           IOException and fail the build outright — which is what broke a deploy. -->
      <id>install-git-hooks</id>
      <activation>
        <file>
          <exists>.git</exists>
        </file>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>3.6.3</version>
            <executions>
              <execution>
                <id>install-git-hooks-path</id>
                <phase>initialize</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <!-- Run via `sh -c … || true` rather than invoking git directly:
                       the exec goal has no failOnError, so a missing `git` binary would
                       otherwise throw IOException and fail the build. The `|| true`
                       swallows a missing-git (or any) failure, so even if a .git dir
                       reaches a git-less build image the step is a no-op instead of a
                       hard failure. `sh` is present on every dev/CI unix host. -->
                  <executable>sh</executable>
                  <arguments>
                    <argument>-c</argument>
                    <argument>git config core.hooksPath .githooks || true</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <profile>
      <!-- Runs ONLY the "js" group. First run auto-downloads the Chromium binary. -->
      <id>js-tests</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <configuration>
              <excludedGroups combine.self="override"></excludedGroups>
              <groups>js</groups>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <!-- Mutation testing over the plain AND the Spring tests: the default PIT block above
           with the "spring" group let back in, so a controller that only a Spring slice covers
           is no longer reported as having no coverage (it was, when this profile ran the Spring
           tests alone). Slow by design (every mutant that only a Spring slice reaches re-runs
           it, and the integration tests need Docker for Testcontainers), so it is run by hand
           when a change is ready to push and is NOT wired into the pre-push hook:
             ./mvnw test-compile org.pitest:pitest-maven:mutationCoverage -Ppit-spring
           Narrow it to what changed, which is the only way it stays tolerable:
             ... -Ppit-spring -DtargetClasses=dev.ted.jittertravel.web.BookFlightItineraryController
                              -DtargetTests=dev.ted.jittertravel.web.BookFlightItineraryControllerTest
           Its report goes to target/pit-reports-spring, so it does not overwrite the fast run's.
           Pointless for templates and CSS: PIT mutates bytecode, so what it checks here is the
           controller, the advice and the wiring behind the page. -->
      <id>pit-spring</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.pitest</groupId>
            <artifactId>pitest-maven</artifactId>
            <configuration>
              <excludedGroups combine.self="override">
                <param>js</param>
                <param>replay-preflight</param>
                <param>performance</param>
              </excludedGroups>
              <reportsDirectory>${project.build.directory}/pit-reports-spring</reportsDirectory>
              <!-- A mutant that breaks context start-up must not be mistaken for a hang, and a
                   cold context takes seconds the unit tier never spends. -->
              <timeoutConstant>60000</timeoutConstant>
              <!-- One Spring context per minion JVM; fewer threads, fewer contexts and databases. -->
              <threads>2</threads>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <!-- Runs ONLY the boot-replay preflight. Point it at a backup dump:
           `mvn test -Preplay-preflight -Dpreflight.dump=/path/to/backup.json`.
           With no dump the single test skips. -->
      <id>replay-preflight</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <configuration>
              <excludedGroups combine.self="override"></excludedGroups>
              <groups>replay-preflight</groups>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

</project>
